{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 scripts/build_frontend.py",
  "installCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://api-production-c6510.up.railway.app/health"
    },
    {
      "source": "/livez",
      "destination": "https://api-production-c6510.up.railway.app/livez"
    },
    {
      "source": "/readyz",
      "destination": "https://api-production-c6510.up.railway.app/readyz"
    },
    {
      "source": "/models",
      "destination": "https://api-production-c6510.up.railway.app/models"
    },
    {
      "source": "/models/:path*",
      "destination": "https://api-production-c6510.up.railway.app/models/:path*"
    },
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/docs/oauth2-redirect",
      "destination": "https://api-production-c6510.up.railway.app/docs/oauth2-redirect"
    },
    {
      "source": "/redoc",
      "destination": "/redoc/index.html"
    },
    {
      "source": "/openapi.json",
      "destination": "https://api-production-c6510.up.railway.app/openapi.json"
    },
    {
      "source": "/metrics",
      "destination": "https://api-production-c6510.up.railway.app/metrics"
    }
  ]
}
